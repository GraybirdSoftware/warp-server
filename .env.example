# Copy to .env and adjust. Every variable is optional.

# SQLite database (created on first start).
DATABASE_URL=sqlite://sqlite.db?mode=rwc

# Bind address.
WARP_HOST=127.0.0.1
WARP_PORT=8080
# Externally reachable base URL, used to build OAuth redirect URIs.
# WARP_PUBLIC_URL=https://warp.example.com

# First-run convenience: if the user table is empty at startup, create this
# admin and print an API key once. Equivalent to `warp-server admin create`.
# WARP_BOOTSTRAP_ADMIN_EMAIL=you@example.com
# WARP_BOOTSTRAP_ADMIN_USERNAME=you

# Browser login via any OAuth 2.0 / OIDC provider (optional). API-key access
# works without this. All five are required together.
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTH_URL=https://accounts.example.com/authorize
# OAUTH_TOKEN_URL=https://accounts.example.com/token
# OAUTH_USERINFO_URL=https://accounts.example.com/userinfo
# OAUTH_SCOPES=openid email profile
# OAUTH_REDIRECT_URL=${WARP_PUBLIC_URL}/api/v1/auth/o/callback
# OAUTH_EMAIL_FIELD=email
# OAUTH_USERNAME_FIELD=preferred_username
# Create accounts for unknown users on first OAuth login (default true).
# WARP_AUTO_REGISTER=true
# WARP_SESSION_TTL_HOURS=720

# Log filter (tracing-subscriber syntax).
# RUST_LOG=info,sqlx=warn
